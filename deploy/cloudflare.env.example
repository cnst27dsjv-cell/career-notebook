# Runtime secrets: configure in Workers Settings > Variables and Secrets.
# Use the Supabase Connect panel's pooled PostgreSQL URL, never a Supabase API key.
DATABASE_URL=postgresql://postgres.PROJECT_REF:YOUR_PASSWORD@YOUR_POOLER_HOST:6543/postgres?sslmode=require
BETTER_AUTH_SECRET=replace-with-a-long-random-secret
APP_URL=https://career-notebook.YOUR_SUBDOMAIN.workers.dev
BETTER_AUTH_URL=https://career-notebook.YOUR_SUBDOMAIN.workers.dev
LOCAL_DEMO=false
MODEL_BASE_URL=https://your-openai-compatible-provider.example/v1
MODEL_API_KEY=
MODEL_NAME=your-general-model
MODEL_POLISH_NAME=your-polish-model
MODEL_SEARCH_NAME=
MAIL_MODE=live
RESEND_API_KEY=
SMTP_FROM=Career Notebook <notebook@YOUR_VERIFIED_DOMAIN>
